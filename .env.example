# متغيّرات البيئة — انسخ إلى .env أو اضبطها على الاستضافة

# التشغيل: development | production
NODE_ENV=development
PORT=3000
# عدد وسطاء البروكسي قبل الخادم (1 عندما يكون خلف nginx/Cloudflare)
TRUST_PROXY=0

# ⚠️ إلزامي في الإنتاج: سلسلة عشوائية طويلة (32 حرفًا فأكثر)
# لتوليدها: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# مدة الجلسة (ملي ثانية) — الافتراضي 30 يومًا، والخمول 7 أيام
SESSION_TTL_MS=2592000000
SESSION_IDLE_MS=604800000
# اتركه فارغًا ليُضبط تلقائيًا: true في الإنتاج (HTTPS)، false في التطوير
COOKIE_SECURE=

# مكان تخزين البيانات (مستخدمون/جلسات/إشعارات)
DATA_DIR=./data

# حدود الطلبات (اختياري — تجاوز إعدادات الإنتاج الافتراضية)
# RL_AUTH=20
# RL_API=240
# RL_SIGNUP=10

# مستوى السجلات: debug | info | warn | error
LOG_LEVEL=info

# ---------- الذكاء الاصطناعي: نماذج مجانية فقط ----------
# بلا أي مفتاح: Pollinations للنص + OCR عربي لصور الصفحات (مدمجان).
# لإضافة رؤية أدق، أضف مفتاح Gemini المجاني من «إعدادات المساعد» أو هنا.
# أي مفتاح مجاني آخر (Groq/OpenRouter/Mistral) يندمج تلقائيًا.
# GOOGLE_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# لإيقاف السحابة المجانية إداريًا (يبقى OCR والمحرك المحلي): AI_CLOUD=off
# أو:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-haiku-latest
# اسم نموذج الرؤية البصرية — مطلوب لقراءة صفحات PDF المصوّرة:
# Google Gemini (مفتاح مجاني): AI_PROVIDER=google + GOOGLE_API_KEY=AIza...
# OpenAI: AI_VISION_MODEL=gpt-4o   |   Anthropic: AI_VISION_MODEL=claude-3-5-sonnet-latest
# مزوّدات متوافقة إضافية: GROQ_API_KEY / OPENROUTER_API_KEY / DEEPSEEK_API_KEY /
# MISTRAL_API_KEY / XAI_API_KEY / TOGETHER_API_KEY / FIREWORKS_API_KEY / CEREBRAS_API_KEY
# عطّل تحليل الصور حتى لو كان المزوّد يدعمها: AI_VISION=false
# مزوّد محلي متوافق مع OpenAI (Ollama/LM Studio): AI_BASE_URL=http://localhost:11434/v1
# RL_AI=40
# حجم JSON الأقصى (صورة الحساب): JSON_LIMIT=3mb

# ---------- إشعارات Web Push (تصل والتطبيق مغلق) ----------
# تُولَّد المفاتيح تلقائيًا مرة واحدة وتُحفظ في data/push-vapid.json،
# ولا تحتاج ضبط أي شيء لتعمل. في الإنتاج يمكنك تثبيتها من البيئة:
# VAPID_PUBLIC_KEY=...   (base64url أو PEM)
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# عطّل المجدول (للاختبارات فقط): DISABLE_SCHEDULER=true
